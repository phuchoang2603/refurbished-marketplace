  "description": "Marketplace service RED from Istio ambient L7 (ingress source + waypoint). Filters reporter=~\"source|waypoint\" and endpoint=http-envoy-prom.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Request rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Request rate by destination app and protocol (ambient: reporter=source|waypoint).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "sum by (destination_app, request_protocol) (\n  rate(istio_requests_total{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\"\n  }[$__rate_interval])\n)",
          "legendFormat": "{{destination_app}} {{request_protocol}}",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "Errors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Fraction of requests with HTTP 4xx/5xx (Istio response_code).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "sum by (destination_app) (\n  rate(istio_requests_total{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\",\n    response_code=~\"[45]..\"\n  }[$__rate_interval])\n)\n/\nclamp_min(\n  sum by (destination_app) (\n    rate(istio_requests_total{\n      destination_service_namespace=~\"$namespace\",\n      reporter=~\"source|waypoint\",\n      endpoint=\"http-envoy-prom\",\n      destination_app=~\"$destination_app\"\n    }[$__rate_interval])\n  ),\n  1e-9\n)",
          "legendFormat": "{{destination_app}}",
          "refId": "A"
        }
      ],
      "title": "Error ratio (4xx/5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Non-OK gRPC status codes (response_code != 0 and != 200).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "sum by (destination_app, response_code) (\n  rate(istio_requests_total{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\",\n    request_protocol=\"grpc\",\n    response_code!=\"0\",\n    response_code!=\"200\"\n  }[$__rate_interval])\n)",
          "legendFormat": "{{destination_app}} {{response_code}}",
          "refId": "A"
        }
      ],
      "title": "gRPC non-OK response rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 102,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "p50 / p95 / p99 request duration from Istio histograms.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 20 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, destination_app) (\n  rate(istio_request_duration_milliseconds_bucket{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\"\n  }[$__rate_interval])\n))",
          "legendFormat": "{{destination_app}} p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, destination_app) (\n  rate(istio_request_duration_milliseconds_bucket{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\"\n  }[$__rate_interval])\n))",
          "legendFormat": "{{destination_app}} p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, destination_app) (\n  rate(istio_request_duration_milliseconds_bucket{\n    destination_service_namespace=~\"$namespace\",\n    reporter=~\"source|waypoint\",\n    endpoint=\"http-envoy-prom\",\n    destination_app=~\"$destination_app\"\n  }[$__rate_interval])\n))",
          "legendFormat": "{{destination_app}} p99",
          "refId": "C"
        }
      ],
      "title": "Request latency (p50 / p95 / p99)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["marketplace", "istio", "red", "ambient"],
