    {
      "id": "app-notes",
      "type": "text",
      "x": 80,
      "y": 1530,
      "width": 1267.2,
      "height": 60.0,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "b2S",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Browse → Search / Meilisearch (no live stock); PDP → Products + Inventory stock read; Web also reads Orders + Payment status.\nSaga: order → reserve stock → hosted session → payment result → commit or release stock → finalize order. Prices come from Products.\nUncertain payments stay under reconciliation; stock rejection never opens payment; a deadline worker drives timeouts + compensation.",
      "roughness": 0,
      "roundness": null,
      "seed": 1683199163,
      "strokeColor": "#52677e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Browse → Search / Meilisearch (no live stock); PDP → Products + Inventory stock read; Web also reads Orders + Payment status.\nSaga: order → reserve stock → hosted session → payment result → commit or release stock → finalize order. Prices come from Products.\nUncertain payments stay under reconciliation; stock rejection never opens payment; a deadline worker drives timeouts + compensation.",
      "textAlign": "left",
      "updated": 1790786597314,
      "version": 1,
      "versionNonce": 968540443,
      "verticalAlign": "top"
    },
