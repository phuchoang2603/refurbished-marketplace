    {
      "id": "notes-text",
      "type": "text",
      "x": 664,
      "y": 716,
      "width": 680,
      "height": 270,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "a16",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Native Istio resilience\n\nIngress   GET: 2 retries on 502/503, 9s per try, 30s total\n          other methods: 25s timeout, never retried\nWaypoint  safe reads + SubmitCheckout: 2 transport\n          retries, 3s per try, 10s total; rest pass through\nDestinationRules  connection + pending limits,\n          20% retry budget, ejection only with >1 replica\n\nDurable recovery stays in the checkout saga (inbox/outbox)",
      "roughness": 1,
      "roundness": null,
      "seed": 10474812,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Native Istio resilience\n\nIngress   GET: 2 retries on 502/503, 9s per try, 30s total\n          other methods: 25s timeout, never retried\nWaypoint  safe reads + SubmitCheckout: 2 transport\n          retries, 3s per try, 10s total; rest pass through\nDestinationRules  connection + pending limits,\n          20% retry budget, ejection only with >1 replica\n\nDurable recovery stays in the checkout saga (inbox/outbox)",
      "textAlign": "center",
      "updated": 1791344091714,
      "version": 1,
      "versionNonce": 617674244,
      "verticalAlign": "middle"
    },
