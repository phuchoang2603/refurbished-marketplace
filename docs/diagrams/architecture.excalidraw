      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Browse / seller list → Search/Meili (no live stock); PDP → Products + Inventory.\nCheckout gets current prices from Products, never Meilisearch.\nSearch and stock can lag creation; their consumer groups are independent.",
      "roughness": 0,
      "roundness": null,
      "seed": 31565173,
      "strokeColor": "#416f51",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Browse / seller list → Search/Meili (no live stock); PDP → Products + Inventory.\nCheckout gets current prices from Products, never Meilisearch.\nSearch and stock can lag creation; their consumer groups are independent.",
      "textAlign": "center",
      "updated": 1790793269519,
      "version": 1,
      "versionNonce": 1419584579,
      "verticalAlign": "middle"
    },
